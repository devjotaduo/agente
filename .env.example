# ============================================================
# LLM de TEXTO (compatível com OpenAI) — padrão: Qwen
# ============================================================
# O padrão do projeto é Qwen. Pode ser servido pelo DashScope nativo OU por
# qualquer roteador compatível com OpenAI (OpenRouter, Groq, Gemini...).
# IMPORTANTE: ao trocar de provedor, ajuste SEMPRE LLM_MODEL junto (senão cai
# no model do banco = qwen-plus e quebra no provedor novo).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen-2.5-72b-instruct

# Outras formas de servir o Qwen / provedores compatíveis com OpenAI:
#   DashScope (Qwen nativo):  LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   Groq (Llama, grátis):     LLM_BASE_URL=https://api.groq.com/openai/v1                            LLM_MODEL=llama-3.3-70b-versatile
#   Gemini:                   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.0-flash

# ============================================================
# Geração de IMAGEM (pôsteres) — Qwen-Image via DashScope nativo
# ============================================================
# Config PRÓPRIA da imagem, independente do texto: roteadores tipo OpenRouter
# NÃO geram imagem, então a imagem usa sempre o endpoint nativo do DashScope.
# Se IMAGE_* ficar vazio, cai de volta nas vars LLM_* (compatibilidade).
# A base nativa é .../api/v1 (não .../compatible-mode/v1).
IMAGE_API_KEY=
IMAGE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# Modelo texto->imagem da Model Studio intl (ex.: qwen-image-2.0, qwen-image-max,
# qwen-image-2.0-pro, wan2.7-image). Geração síncrona (multimodal-generation).
IMAGE_MODEL=qwen-image-2.0

# ============================================================
# Instagram / Meta — conexão "Conectar Instagram" (web)
# ============================================================
# Opção A (recomendada): login DIRETO do Instagram, sem Página do Facebook.
#   Meta app → produto "Instagram" → "API setup with Instagram login".
#   Pegue Instagram App ID/Secret e cadastre o redirect:
#     {APP_URL}/api/admin/instagram/oauth/ig/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Opção B (alternativa): via Página do Facebook (Facebook Login for Business).
#   App da Meta → Configurações → Básico. Redirect:
#     {APP_URL}/api/admin/instagram/callback
# META_APP_SECRET é server-only — NUNCA prefixar com NEXT_PUBLIC.
META_APP_ID=
META_APP_SECRET=
# URL pública do app web (usada no Redirect URI do OAuth). Em dev, deixe vazio
# que usamos a origem da requisição (ex.: http://localhost:3000).
# Em produção: https://seu-dominio.com
NEXT_PUBLIC_APP_URL=
# Redirect URI a cadastrar no app da Meta:  {APP_URL}/api/admin/instagram/callback
# (o token de longa duração e o IG User ID são salvos POR AGENTE no banco, não aqui.)

# Worker reaproveita SUPABASE_URL / SERVICE_ROLE_KEY / LLM_* acima.
SUPABASE_URL=

# ============================================================
# Ponte QwenPaw (opt-in) — WhatsApp usa o QwenPaw como cérebro
# ============================================================
# Quando WHATSAPP_BRIDGE=qwenpaw, o worker NÃO responde com generateReply local;
# encaminha a mensagem ao QwenPaw (agente+skills+memória) e a resposta volta
# async pelo servidor /send do worker. Sem isso, mantém o comportamento atual.
# WHATSAPP_BRIDGE=qwenpaw
# URL do QwenPaw (Console/API):
QWENPAW_URL=http://127.0.0.1:8088
# Qual agente do QwenPaw responde (workspace; ex.: default, vendas, marketing):
QWENPAW_AGENT_ID=default
# Porta do servidor /send do worker (o canal whatsapp do QwenPaw chama aqui).
# Deve bater com worker_send_url no config.json do QwenPaw.
QWENPAW_BRIDGE_PORT=8099

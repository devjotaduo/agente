# ============================================================
# Supabase (projeto DEDICADO desta plataforma)
# ============================================================
# Públicos (browser) — usados pelo apps/web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NUNCA prefixar com NEXT_PUBLIC.
# Usado por route handlers/server actions de admin (web) e pelo worker.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Anthropic Claude
# ============================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ============================================================
# Worker WhatsApp (apps/whatsapp-worker) — ver apps/whatsapp-worker/.env
# ============================================================
# Reaproveita SUPABASE_URL / SERVICE_ROLE_KEY / ANTHROPIC_API_KEY acima.
SUPABASE_URL=

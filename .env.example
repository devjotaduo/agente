# ============================================================
# Supabase (projeto DEDICADO desta plataforma)
# ============================================================
# Públicos (browser) — usados pelo apps/web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NUNCA prefixar com NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# LLM (compatível com OpenAI) — padrão: Alibaba Qwen / DashScope
# ============================================================
# Chave da API do provedor (server-only).
LLM_API_KEY=
# Base URL compatível com OpenAI. Qwen/DashScope internacional:
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Modelo padrão (ex.: qwen-plus, qwen-turbo, qwen-max).
LLM_MODEL=qwen-plus

# Outros provedores grátis (compatíveis com OpenAI), caso troque:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1            LLM_MODEL=llama-3.3-70b-versatile
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.0-flash

# ============================================================
# Geração de imagem (pôsteres) — DashScope / Tongyi Wanxiang
# ============================================================
# Reusa LLM_API_KEY e a conta DashScope. A base de imagem é o endpoint NATIVO
# (.../api/v1) — o código converte automaticamente a partir de LLM_BASE_URL.
# Modelo texto->imagem da Model Studio intl (ex.: qwen-image-2.0, qwen-image-max,
# qwen-image-2.0-pro, wan2.7-image). Geração síncrona (multimodal-generation).
IMAGE_MODEL=qwen-image-2.0

# ============================================================
# Instagram / Meta — OAuth "Conectar Instagram" (web)
# ============================================================
# App da Meta (developers.facebook.com → Configurações → Básico).
# META_APP_SECRET é server-only — NUNCA prefixar com NEXT_PUBLIC.
META_APP_ID=
META_APP_SECRET=
# URL pública do app web (usada no Redirect URI do OAuth). Em dev, deixe vazio
# que usamos a origem da requisição (ex.: http://localhost:3000).
# Em produção: https://seu-dominio.com
NEXT_PUBLIC_APP_URL=
# Redirect URI a cadastrar no app da Meta:  {APP_URL}/api/admin/instagram/callback
# (o token de longa duração e o IG User ID são salvos POR AGENTE no banco, não aqui.)

# Worker reaproveita SUPABASE_URL / SERVICE_ROLE_KEY / LLM_* acima.
SUPABASE_URL=
